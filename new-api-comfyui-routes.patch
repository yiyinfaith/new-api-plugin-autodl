@@ -0,0 +1,36 @@
+package jsplugin
+
+import (
+    "strings"
+    "testing"
+)
+
+func TestOfficialComfyUIReservedNamespaceException(t *testing.T) {
+    cases := []struct {
+        name, method, path string
+        kind RouteType
+        allowed bool
+    }{
+        {"submit", "POST", "/api/v1/comfyui/comfyui_workflow/:workflow_id", RouteTypeSubmit, true},
+        {"query", "GET", "/api/v1/comfyui/comfyui_workflow/result/:task_id", RouteTypeQuery, true},
+        {"management", "POST", "/api/channel/:workflow_id", RouteTypeSubmit, false},
+        {"other method", "PUT", "/api/v1/comfyui/comfyui_workflow/:workflow_id", RouteTypeSubmit, false},
+        {"wrong type", "POST", "/api/v1/comfyui/comfyui_workflow/:workflow_id", RouteTypeDynamic, false},
+        {"wrong query method", "POST", "/api/v1/comfyui/comfyui_workflow/result/:task_id", RouteTypeSubmit, false},
+        {"catchall", "POST", "/api/v1/comfyui/comfyui_workflow/*workflow_id", RouteTypeSubmit, false},
+        {"different parameter", "POST", "/api/v1/comfyui/comfyui_workflow/:model", RouteTypeSubmit, false},
+        {"extra segment", "POST", "/api/v1/comfyui/comfyui_workflow/:workflow_id/extra", RouteTypeSubmit, false},
+        {"other API", "GET", "/api/v1/comfyui/other/:task_id", RouteTypeQuery, false},
+    }
+    for _, row := range cases {
+        t.Run(row.name, func(t *testing.T) {
+            route := Route{Method: row.method, Path: row.path, Type: row.kind, Render: "present"}
+            if row.kind != RouteTypeQuery { route.Decode = "decode" }
+            err := validateRoute(&route)
+            if row.allowed && err != nil { t.Fatalf("official route rejected: %v", err) }
+            if !row.allowed && (err == nil || !strings.Contains(err.Error(), "reserved namespace /api")) {
+                t.Fatalf("reserved route accepted or wrong error: %v", err)
+            }
+        })
+    }
+}

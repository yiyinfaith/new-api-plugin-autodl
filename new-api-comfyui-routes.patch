+package jsplugin
+
+import (
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestOfficialTaskReservedNamespaceException(t *testing.T) {
+	allowed := []Route{
+		{Method: "POST", Path: "/api/v1/comfyui/comfyui_workflow/:workflow_id", Type: RouteTypeSubmit},
+		{Method: "GET", Path: "/api/v1/comfyui/comfyui_workflow/result/:task_id", Type: RouteTypeQuery},
+		{Method: "POST", Path: "/api/v1/services/aigc/image2video/video-synthesis", Type: RouteTypeSubmit},
+		{Method: "GET", Path: "/api/v1/tasks/:task_id", Type: RouteTypeQuery},
+	}
+	for _, row := range allowed {
+		row.Render = "present"
+		if row.Type == RouteTypeSubmit {
+			row.Decode = "decode"
+		}
+		require.NoError(t, validateRoute(&row), row.Path)
+		for _, method := range []string{"GET", "POST", "PUT", "DELETE", "PATCH"} {
+			if method == row.Method {
+				continue
+			}
+			candidate := row
+			candidate.Method = method
+			err := validateRoute(&candidate)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "reserved namespace /api")
+		}
+		for _, kind := range []RouteType{RouteTypeSubmit, RouteTypeQuery, RouteTypeDynamic} {
+			if kind == row.Type {
+				continue
+			}
+			candidate := row
+			candidate.Type = kind
+			err := validateRoute(&candidate)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "reserved namespace /api")
+		}
+	}
+	paths := []string{
+		"/api/channel/:workflow_id",
+		"/api/v1/comfyui/comfyui_workflow/*workflow_id",
+		"/api/v1/comfyui/comfyui_workflow/:model",
+		"/api/v1/comfyui/comfyui_workflow/:workflow_id/extra",
+		"/api/v1/comfyui/other/:task_id",
+		"/api/v1/tasks/*task_id",
+		"/api/v1/tasks/:id",
+		"/api/v1/tasks/:task_id/extra",
+		"/api/v1/services/aigc/*service",
+		"/api/v1/services/aigc/text2video/video-synthesis",
+		"/api/v1/services/aigc/image2video/video-synthesis/extra",
+		"/api/*path", "/api/v1/*path",
+	}
+	for _, path := range paths {
+		for _, method := range []string{"GET", "POST"} {
+			row := Route{Method: method, Path: path, Type: RouteTypeSubmit, Decode: "decode", Render: "present"}
+			if method == "GET" {
+				row.Type = RouteTypeQuery
+				row.Decode = ""
+			}
+			err := validateRoute(&row)
+			require.Error(t, err, path)
+			assert.Contains(t, err.Error(), "reserved namespace /api")
+		}
+	}
+}

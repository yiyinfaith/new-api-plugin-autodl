+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/service"
+)
+
+const maxMeasuredVideoBytes int64 = 256 << 20
+
+var videoMeasurementSlots = make(chan struct{}, 4)
+
+type videoUsageMeasurementError struct{}
+
+func (*videoUsageMeasurementError) Error() string {
+	return "video usage measurement failed; a public MP4/WebM URL or standard video Data URL with duration in (0, 3600] seconds is required"
+}
+
+// prepareUsageMeasurements executes network and media work outside the JS VM.
+// Only host-owned scalar measurements reach extractUsage; no URL credentials or
+// channel authorization are forwarded to the media server or local ffprobe.
+func (a *TaskAdaptor) prepareUsageMeasurements(ctx context.Context, hookContext map[string]any, result any) error {
+	if !a.hasHook(ctx, "measureUsage") {
+		return nil
+	}
+	var descriptor map[string]any
+	if err := a.plugin.Engine.CallInto(ctx, &descriptor, "measureUsage", hookContext, result); err != nil {
+		return &videoUsageMeasurementError{}
+	}
+	if len(descriptor) == 0 {
+		return nil
+	}
+	if len(descriptor) > 4 {
+		return &videoUsageMeasurementError{}
+	}
+	ctx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+	schema, _ := a.plugin.Meta.UsageForModels(stringValue(hookContext["upstreamModel"]), stringValue(hookContext["model"]))
+	measurements := make(map[string]any, len(descriptor))
+	for field, value := range descriptor {
+		rule, exists := schema[field]
+		source, ok := value.(map[string]any)
+		videoURL, _ := source["videoUrl"].(string)
+		if !exists || rule.Type != "number" || rule.Unit != "second" || !ok || len(source) != 1 || videoURL == "" {
+			return &videoUsageMeasurementError{}
+		}
+		var seconds float64
+		var err error
+		if result == nil && strings.HasPrefix(strings.ToLower(videoURL), "data:") {
+			seconds, err = measureDataVideo(ctx, videoURL)
+		} else {
+			seconds, err = measurePublicVideo(ctx, videoURL)
+		}
+		if err != nil {
+			return &videoUsageMeasurementError{}
+		}
+		measurements[field] = seconds
+	}
+	hookContext["usageMeasurements"] = measurements
+	return nil
+}
+
+func stringValue(value any) string { text, _ := value.(string); return text }
+
+func (a *TaskAdaptor) completionUsage(ctx context.Context, hookContext map[string]any, result any, body any) (any, error) {
+	if err := a.prepareUsageMeasurements(ctx, hookContext, result); err != nil {
+		return nil, err
+	}
+	return a.plugin.Engine.Call(ctx, "extractUsageOnComplete", hookContext, result, body)
+}
+
+func measurePublicVideo(parent context.Context, videoURL string) (float64, error) {
+	ctx, cancel := context.WithTimeout(parent, 45*time.Second)
+	defer cancel()
+	select {
+	case videoMeasurementSlots <- struct{}{}:
+		defer func() { <-videoMeasurementSlots }()
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+	parsed, err := url.Parse(videoURL)
+	if err != nil || parsed.Host == "" || (parsed.Scheme != "http" && parsed.Scheme != "https") || parsed.User != nil || parsed.Fragment != "" {
+		return 0, errors.New("invalid media URL")
+	}
+	if err := service.ValidateSSRFProtectedFetchURL(videoURL); err != nil {
+		return 0, errors.New("blocked media URL")
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, videoURL, nil)
+	if err != nil {
+		return 0, err
+	}
+	response, err := service.GetSSRFProtectedHTTPClient().Do(request)
+	if err != nil {
+		return 0, errors.New("media download failed")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK || response.ContentLength > maxMeasuredVideoBytes {
+		return 0, errors.New("media download rejected")
+	}
+	file, err := os.CreateTemp("", "task-video-*")
+	if err != nil {
+		return 0, err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	written, err := io.Copy(file, io.LimitReader(response.Body, maxMeasuredVideoBytes+1))
+	if err != nil || written == 0 || written > maxMeasuredVideoBytes {
+		return 0, errors.New("media is empty, incomplete or too large")
+	}
+	if err := file.Close(); err != nil {
+		return 0, err
+	}
+	return probeVideoDuration(ctx, file.Name())
+}
+
+// Only submission measurements accept inline input. Completion continues to
+// use the public URL fetcher and never decodes provider-returned Data URLs.
+func measureDataVideo(parent context.Context, dataURL string) (float64, error) {
+	ctx, cancel := context.WithTimeout(parent, 45*time.Second)
+	defer cancel()
+	select {
+	case videoMeasurementSlots <- struct{}{}:
+		defer func() { <-videoMeasurementSlots }()
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+	header, payload, ok := strings.Cut(dataURL, ",")
+	header = strings.ToLower(header)
+	if !ok || (header != "data:video/mp4;base64" && header != "data:video/webm;base64") || payload == "" || strings.ContainsAny(payload, "\r\n") || len(payload) > base64.StdEncoding.EncodedLen(int(maxMeasuredVideoBytes)) {
+		return 0, errors.New("invalid video Data URL")
+	}
+	raw, err := base64.StdEncoding.Strict().DecodeString(payload)
+	if err != nil || len(raw) == 0 || int64(len(raw)) > maxMeasuredVideoBytes {
+		return 0, errors.New("invalid or oversized inline video")
+	}
+	file, err := os.CreateTemp("", "task-video-*")
+	if err != nil {
+		return 0, err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	if _, err := file.Write(raw); err != nil {
+		return 0, err
+	}
+	if err := file.Close(); err != nil {
+		return 0, err
+	}
+	return probeVideoDuration(ctx, file.Name())
+}
+
+func boundedVideoDuration(seconds float64) (float64, error) {
+	if math.IsNaN(seconds) || math.IsInf(seconds, 0) || seconds <= 0 || seconds > relaycommon.MaxTaskDurationSeconds {
+		return 0, errors.New("video duration is outside the billing bound")
+	}
+	return seconds, nil
+}
+
+func probeVideoDuration(parent context.Context, filename string) (float64, error) {
+	ctx, cancel := context.WithTimeout(parent, 10*time.Second)
+	defer cancel()
+	// Demux only a complete local MP4/WebM file. No playlists, external tracks,
+	// URLs, network protocols or shell are available to this process.
+	args := []string{"-v", "error", "-protocol_whitelist", "file", "-format_whitelist", "mov,matroska,webm", "-select_streams", "v:0"}
+	command := exec.CommandContext(ctx, "ffprobe", append(args, "-show_entries", "stream=codec_type,duration", "-of", "json", filename)...)
+	var buffer bytes.Buffer
+	command.Stdout = &limitedProbeWriter{Writer: &buffer, remaining: 64 << 10}
+	if err := command.Run(); err != nil {
+		return 0, errors.New("video probe failed")
+	}
+	var metadata struct {
+		Streams []struct {
+			CodecType string `json:"codec_type"`
+			Duration  string `json:"duration"`
+		} `json:"streams"`
+	}
+	if err := common.Unmarshal(buffer.Bytes(), &metadata); err != nil || len(metadata.Streams) != 1 || metadata.Streams[0].CodecType != "video" {
+		return 0, errors.New("media contains no video stream")
+	}
+	if value := metadata.Streams[0].Duration; value != "" && value != "N/A" {
+		seconds, err := strconv.ParseFloat(value, 64)
+		if err != nil {
+			return 0, err
+		}
+		return boundedVideoDuration(seconds)
+	}
+	// WebM commonly omits per-track Duration. Count the video packet timeline,
+	// rather than format.duration (which may follow a longer audio track).
+	command = exec.CommandContext(ctx, "ffprobe", append(args, "-show_packets", "-show_entries", "packet=pts_time,duration_time", "-of", "csv=p=0", filename)...)
+	stdout, err := command.StdoutPipe()
+	if err != nil {
+		return 0, err
+	}
+	if err := command.Start(); err != nil {
+		return 0, err
+	}
+	scanner := bufio.NewScanner(io.LimitReader(stdout, 64<<20))
+	first, last := math.Inf(1), math.Inf(-1)
+	count := 0
+	for scanner.Scan() {
+		parts := strings.Split(scanner.Text(), ",")
+		if len(parts) != 2 {
+			err = errors.New("invalid packet timeline")
+			break
+		}
+		pts, e1 := strconv.ParseFloat(parts[0], 64)
+		duration, e2 := strconv.ParseFloat(parts[1], 64)
+		if e1 != nil || e2 != nil || math.IsNaN(pts) || math.IsInf(pts, 0) || math.IsNaN(duration) || math.IsInf(duration, 0) || duration <= 0 || math.Abs(pts) > relaycommon.MaxTaskDurationSeconds*2 || duration > relaycommon.MaxTaskDurationSeconds {
+			err = errors.New("invalid packet duration")
+			break
+		}
+		first, last = math.Min(first, pts), math.Max(last, pts+duration)
+		count++
+		if count > 1000000 {
+			err = errors.New("video packet limit exceeded")
+			break
+		}
+	}
+	if scanErr := scanner.Err(); scanErr != nil {
+		err = scanErr
+	}
+	if err != nil {
+		cancel()
+	}
+	if waitErr := command.Wait(); waitErr != nil && err == nil {
+		err = waitErr
+	}
+	if err != nil || count == 0 {
+		return 0, errors.New("video packet probe failed")
+	}
+	return boundedVideoDuration(last - first)
+}
+
+type limitedProbeWriter struct {
+	io.Writer
+	remaining int
+}
+
+func (w *limitedProbeWriter) Write(data []byte) (int, error) {
+	if len(data) > w.remaining {
+		return 0, fmt.Errorf("probe metadata exceeds size limit")
+	}
+	n, err := w.Writer.Write(data)
+	w.remaining -= n
+	return n, err
+}
+
+func (a *TaskAdaptor) prepareSubmitUsage(ctx context.Context, hookContext map[string]any) error {
+	if len(a.usageMeasurements) > 0 {
+		hookContext["usageMeasurements"] = a.usageMeasurements
+		return nil
+	}
+	if err := a.prepareUsageMeasurements(ctx, hookContext, nil); err != nil {
+		return err
+	}
+	if values, ok := hookContext["usageMeasurements"].(map[string]any); ok {
+		a.usageMeasurements = values
+	}
+	return nil
+}
